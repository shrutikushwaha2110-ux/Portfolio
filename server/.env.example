# Copy this file to .env and fill in real values. Never commit .env.

# Required for the AI-powered chatbot. Without it, the chatbot falls back to
# keyword-based answers and the rest of the site works normally.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the Claude model used by the chatbot.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Port the API server listens on.
PORT=5174

# Comma-separated list of allowed frontend origins (CORS).
# Local dev:
CORS_ORIGIN=http://localhost:5173
# Production example (GitHub Pages):
# CORS_ORIGIN=https://shrutikushwaha2110-ux.github.io
